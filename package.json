{
  "name": "phantom-heist",
  "version": "1.0.0",
  "description": "Phantom Heist - Build trap vaults and raid others! A mobile game for Google Play.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init \"Phantom Heist\" com.phantomheist.game --web-dir dist",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "deploy": "npm run build && npx cap sync && npx cap open android"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "howler": "^2.2.4",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "terser": "^5.46.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.19"
  }
}
